{
  "name": "dsh-balanced-search",
  "version": "0.3.0",
  "description": "Balanced web search for DeepSeek Harness: Keenable / Exa / Tavily / Firecrawl / Bright Data round-robin search and fetch with automatic failover. Registers balanced_search / balanced_fetch as dsh tools, takes the built-in web_search / web_fetch over through the ctx.web seam, and renders the two tools with an official-style card (plus a 'balanced' suffix) from a client half.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "server.py",
    "providers.py",
    "requirements.txt",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "mcp",
    "search",
    "web-search",
    "web-fetch",
    "provider",
    "keenable",
    "exa",
    "tavily",
    "firecrawl",
    "bright-data"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianmingwan/dsh-balanced-search.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "external": []
    }
  },
  "engines": {
    "node": ">=20"
  }
}
