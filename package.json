{
  "name": "dsh-balanced-search",
  "version": "0.2.0",
  "description": "Balanced web search for DeepSeek Harness: Keenable / Exa / Tavily round-robin search and fetch, with automatic failover. Registers balanced_search / balanced_fetch tools and takes over the built-in web_search / web_fetch.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "server.py",
    "providers.py",
    "requirements.txt",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "mcp",
    "search",
    "web-search",
    "web-fetch",
    "provider",
    "keenable",
    "exa",
    "tavily"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianmingwan/dsh-balanced-search.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
